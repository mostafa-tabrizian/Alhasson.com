# DO NOT REMOVE: Passenger startup generated by cPanel
PassengerAppRoot "/home/rzygmozy/apps/hadith-center"
PassengerBaseURI "/"
PassengerNodejs "/home/rzygmozy/nodevenv/hadith-center/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js

# Keep at least one Node instance warm to avoid idle cold-starts on dynamic routes
PassengerMinInstances 1

# Static file direct bypass (Optional: serves Next static assets directly via Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_next/static/(.*)$ /home/rzygmozy/apps/hadith-center/.next/static/$1 [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>